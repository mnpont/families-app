{
  "name": "families-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "backup:words": "tsx scripts/exportWordsBackup.ts",
    "backfill:dry-run": "tsx scripts/backfillToV2Schema.ts --source=local --dry-run",
    "backfill:live": "tsx scripts/backfillToV2Schema.ts --source=live"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
